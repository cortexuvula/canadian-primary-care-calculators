{
  "name": "canadian-primary-care",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "test:browser": "playwright test",
    "test:mutations": "node scripts/mutations.js",
    "inventory": "node scripts/inventory.js",
    "sdk:fetch": "node scripts/fetch-sdk.js",
    "test:browser:sdk": "npm run sdk:fetch && CPC_SDK_FIXTURE=1 playwright test",
    "release": "python3 scripts/release.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@tabler/icons-react": "3.44.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.6.7",
    "tailwind-merge": "3.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Andre Hugo",
  "description": "Offline Canadian-unit clinician decision-support calculators for Hermes Desktop (preview).",
  "repository": {
    "type": "git",
    "url": "https://github.com/cortexuvula/canadian-primary-care-calculators.git"
  },
  "homepage": "https://github.com/cortexuvula/canadian-primary-care-calculators",
  "bugs": {
    "url": "https://github.com/cortexuvula/canadian-primary-care-calculators/issues"
  }
