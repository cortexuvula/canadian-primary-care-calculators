{
  "_meta": {
    "title": "Canadian Primary Care Batch A - full-precision independent vectors (11 additions)",
    "author": "doc (clinical research bot)",
    "accessDate": "2026-10-27",
    "baselineRepo": "aaf0eb9f190c890c71bbbb8cc3148c18bf32caab",
    "sourceBrief": "Clinical contract supplied independently by Doc; public implementation summary: docs/batch-a-clinical-guide.md",
    "computation": "Independent Python 3 math stdlib (no production code import, no patient data).",
    "precisionNote": "Numeric outputs are IEEE-754 binary64 (double), serialized as shortest round-trip decimal (json.dump). Integer scores compare exactly. Derived floats compare EXACTLY only when the implementation mirrors pinnedOperationOrder; otherwise assert |actual-expected| <= 1e-9 absolute (or 1e-12 relative).",
    "pinnedOperationOrder": {
      "ariscat": "sum of 7 point terms per Canet Table 6 (age<=50:0/51-80:3/>80:16; SpO2>=96:0/91-95:8/<=90:24; respInf:17; anaemia Hb<=100 g/L:11; incision peripheral:0/upper-abdominal:15/intrathoracic:24; duration <=2h:0/2-3h:16/>3h:23; emergency:8). Risk class <26 Low / 26-44 Intermediate / >=45 High.",
      "apgar": "appearance+pulse+grimace+activity+respiration (each 0-2)",
      "ciwa-ar": "sum of 10 item scores (9 x 0-7 + orientation 0-4)",
      "westley-croup": "consciousness(0/5)+cyanosis(0/4/5)+stridor(0/1/2)+airEntry(0/1/2)+retractions(0/1/2/3)",
      "aec": "wbc * eosinophils / 100 ; aecPerMicrolitre = aec * 1000",
      "ga-from-edd": "daysToEdd=(edd-asOf).days; gestationalDays=280-daysToEdd; weeks=//7; days=%7",
      "maintenance-fluids": "w<=10:100*w ; w<=20:1000+50*(w-10) ; else 1500+20*(w-20)",
      "posttest-lr": "odds=p/(1-p); odds*=prod(LRs); post=odds/(1+odds)",
      "posttest-sens-spec": "positive LR=sens/(1-spec); negative LR=(1-sens)/spec; post=(odds*LR)/(1+odds*LR)",
      "urine-acr": "alb(mg/L)/creat(mmol/L) [mg/mmol]; alb(mg/L)/creat(mg/L)*1000 [mg/g]",
      "urine-pcr": "protein(mg/L)/creat(mmol/L) [mg/mmol]; protein(mg/L)/creat(mg/L)*1000 [mg/g]"
    },
    "constants": {
      "creatinineMwGPerMol": 113.12,
      "mgGPerMgMmol": 8.84016973125884,
      "mgMmolPerMgG": 0.11312,
      "naegeleDays": 280,
      "anaemiaHbGL": 100.0
    },
    "sourceCorrections": {
      "ariscatPmid": "21045639 (NOT 21145643 - that resolves to a psychology paper). Canet J, Gallart L, Gomar C et al., Anesthesiology 2010;113(6):1338-50.",
      "dailyVs421": "Daily Holliday-Segar (100/50/20 mL/kg/day) is NOT the 4-2-1 hourly shortcut x24 (96/48/24).",
      "creatinineFactor": "Use MW 113.12 (exact bridge 0.11312 / 8.84017...). KDIGO '0.113' and '3 mg/mmol ~ 30 mg/g' are rounded staging approximations, not exact conversion."
    }
  },
