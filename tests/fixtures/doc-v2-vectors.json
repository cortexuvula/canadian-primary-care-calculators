{
  "_meta": {
    "title": "Canadian Primary Care v2 - full-double-precision synthetic vectors (all 12 additions)",
    "author": "doc (clinical research bot)",
    "accessDate": "2026-10-26",
    "computation": "Independent Python 3 math stdlib; no production imports; no patient data.",
    "precisionNote": "All numeric outputs are IEEE-754 binary64 (double), serialized as the shortest decimal that round-trips to the identical double (Python repr / json.dumps). JSON.parse in JS reproduces the exact same double. Derived floats compare EXACTLY only when the implementation mirrors the pinnedOperationOrder below; otherwise assert |actual-expected| <= 1e-9 (absolute) or use relative tolerance 1e-12. Integer scores compare exactly.",
    "pinnedOperationOrder": {
      "bmi": "weight / ((heightCm/100)*(heightCm/100))",
      "bsa": "sqrt(heightCm*weightKg/3600)",
      "cockcroftGault": "((140-ageYears)*weightKg*88.4)/(72*scrUmolL), then *0.85 if female",
      "fib4": "(ageYears*astUperL)/(platelets109L*sqrt(altUperL))",
      "apri": "(astUperL*100)/(astUlnUperL*platelets109L)  [algebraically identical to brief's ((AST/ULN)*100)/PLT, re-associated so boundary vectors land exactly on 0.5/1.5/2.0]",
      "anionGap": "raw=na-(cl+hco3); withK=(na+k)-(cl+hco3); corrected=raw+0.25*(refAlbumin-albumin)",
      "correctedSodium": "gluMgDl=glucoseMmolL*18.016; na+factor*(gluMgDl-100)/100",
      "qtc": "rr=60/hrBpm; bazett=qt/sqrt(rr); fridericia=qt/rr^(1/3); framingham=(qt/1000+0.154*(1-rr))*1000; hodges=qt+1.75*(hr-60)",
      "homaB": "(20*(insulinPmolL/6.0))/(glucoseMmolL-3.5)",
      "quicki": "1/(log10(insulinPmolL/6.0)+log10(glucoseMmolL*18.016))"
    },
    "constants": {
      "glucoseMmolLToMgDl": 18.016,
      "creatinineUmolLToMgDl": 88.4,
      "cgSiFactorMale": 1.2277777777777779,
      "cgFemaleFactor": 0.85,
      "insulinPmolLToMuL": 6.0,
      "mostellerDivisor": 3600.0,
      "duboisCoeff": 0.007184,
      "figgeSlope": 0.25,
      "figgeRefAlbuminGL_default": 44.0,
      "figgeRefAlbuminGL_variant": 40.0,
      "katzFactor": 1.6,
      "hillierFactor": 2.4,
      "qtcFraminghamSlope": 0.154,
      "qtcHodgesMsPerBpm": 1.75,
      "homaBNumerator": 20.0,
      "homaBGlucoseOffset": 3.5
    },
    "resolutions": {
      "fib4AgeAndAcuteDisease": "age<18 reject; age 18-34 valid+warning; age>=65 age-adjusted band; acute disease = non-blocking contraindication note (not a numeric guard)",
      "bmiPregnancyLactationGate": "required Yes/No choice; Yes -> numeric BMI reported but weight class suppressed",
      "hasBledLabileInrVsDoac": "3-state L: no/yes_vka/na_doac_none (DOAC or none -> N/A, scores 0, shown as N/A not silent No)",
      "cockcroftGaultWeightBasis": "single clinician-supplied weight (kg); NO ideal/adjusted-weight formula computed; obesity caveat surfaced; clinician may enter an alternative weight basis directly"
    }
  },
